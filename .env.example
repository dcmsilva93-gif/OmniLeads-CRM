# Copy to .env and fill in. Never commit the real .env.
# In production these are set under Environment in Roar, not in a file.

# --- Roar AI gateway (for lead scoring and draft emails) ---
ROAR_API_KEY=roar_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ROAR_BASE_URL=https://api.roar-ai.com/v1
# ROAR_MODEL=claude-haiku-5-5

# --- Meta Lead Ads (all four are server-side only) ---
# Any long random string you invent; paste the identical value into Meta's
# webhook setup screen as the Verify Token.
META_VERIFY_TOKEN=
# Meta app -> Settings -> Basic -> App secret. Used to verify that each
# delivery really came from Meta.
META_APP_SECRET=
# A Page access token holding the leads_retrieval permission, from the Graph
# API Explorer or your app's token tooling. Used to fetch each lead's answers.
META_PAGE_ACCESS_TOKEN=
META_GRAPH_VERSION=v26.0

# Only for tests — points the Graph API calls at a stub.
# META_GRAPH_BASE=http://127.0.0.1:3470
